import random

class TetrisGame:
    def __init__(self):
        self.board = [[' ' for _ in range(7)] for _ in range(10)]
        self.current_piece = self.generate_piece()
        self.current_row = 0
        self.current_col = 0

    def generate_piece(self):
        # Generate a random piece
        piece = [' ' for _ in range(7)]
        for i in range(3):
            for j in range(3):
                if random.randint(0, 1) == 0:
                    piece[i][j] = chr(ord('A') + i)
                    break
        return piece

    def move_piece(self, direction):
        # Move the current piece in the given direction
        if direction == 'left':
            self.current_col -= 1
            if self.current_col < 0:
                self.current_col = 7
        elif direction == 'right':
            self.current_col += 1
            if self.current_col > 7:
                self.current_col = 0
        elif direction == 'down':
            self.current_row += 1
            if self.current_row > 7:
                self.current_row = 0
        elif direction == 'up':
            self.current_row -= 1

    def drop_piece(self):
        # Drop the current piece to the bottom of the board
