import random

class TetrisGame:
    def __init__(self):
        self.board = [[' ' for _ in range(7)] for _ in range(10)]
        self.current_piece = self.generate_piece()
        self.current_row = 0
        self.current_col = 0

    def generate_piece(self):
        # Generate a random piece
        piece = [' ' for _ in range(7)]
        for i in range(3):
            for j in range(3):
                if random.randint(0, 1) == 0:
                    piece[i][j] = chr(ord('A') + i)
                    break
        return piece

    def move_piece(self, direction):
        # Move the current piece in the given direction
        if direction == 'up':
            self.current_row -= 1
        elif direction == 'down':
            self.current_row += 1
        elif direction == 'left':
            self.current_col -= 1
        elif direction == 'right':
            self.current_col += 1

        # Check if the piece has reached the bottom
        if self.current_row == 10:
            self.add_piece()

    def add_piece(self):
        # Add a new row to the board for the current piece
        for i in range(len(self.current_piece)):
            if self.current_piece[i] != ' ':
                self.board[self.current_row + i][self.current_col] = self.current_piece[i]
        self.current_piece = [' ' for _ in range(7)]
