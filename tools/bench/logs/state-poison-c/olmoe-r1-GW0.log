import random

class TetrisGame:
    def __init__(self):
        self.board = [[' ' for _ in range(7)] for _ in range(10)]
        self.current_piece = self.get_random_piece()
        self.current_row = 0
        self.current_col = 0

    def get_random_piece(self):
        # Tetromino shapes and their corresponding pieces
        tetrominoes = [
            ['T', '#', 'O'],
            ['I', ' ', 'O'],
            ['L', '|', 'O'],
            ['J', '\\', 'O'],
            ['S', '/', 'O'],
            ['Z', 'Z', 'O']
        ]
        return random.choice(tetrominoes)

    def move_piece(self):
        # Move the current piece left or right
        if self.current_col == 7:
            self.current_piece = self.get_random_piece()
            self.current_col = 0
