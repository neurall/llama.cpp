class TetrisGame:
    def __init__(self):
        self.board = [[' ' for _ in range(7)] for _ in range(10)]
        self.current_piece = self.get_random_piece()
        self.current_row = 0
        self.current_col = 0

    def get_random_piece(self):
        # Tetromino shapes and their corresponding letters
        tetrominos = [
