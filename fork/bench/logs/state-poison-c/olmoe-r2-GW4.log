            ['L', 'Z'],
            ['J', 'O', 'P'],
            ['G', 'R', 'M'],
            ['E', 'A', 'T'],
            ['D', 'U', 'L'],
            [' ', ' ', ' ', ' ']
        ]
        return random.choice(tetrominos)

    def move_piece(self, direction):
        # Move the current piece in the given direction
        self.current_piece = self.current_piece[1:] + self.current_piece[0]
        if direction == 'up':
            self.current_row += 1
        elif direction == 'down':
            self.current_row -= 1
        elif direction == 'left':
            self.current_col -= 1
        elif direction == 'right':
            self.current_col += 1

