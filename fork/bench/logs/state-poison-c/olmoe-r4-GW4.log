import random

class TetrisGame:
    def __init__(self):
        self.board = [[' ' for _ in range(7)] for _ in range(10)]
        self.current_piece = self.get_random_piece()
        self.current_row = 0
        self.current_col = 0

    def draw_piece(self):
        for row in self.current_piece:
            print('|{}|'.format(' ' * (7 - len(row))), end='')
            for col in row:
                print(col, end='')
            print()
        print('|{}|'.format(' ' * (7 - len(self.current_piece[0]))), end='')
        for row in self.current_piece[::-1]:
            print('|{}|'.format(' ' * (7 - len(row))), end='')
            for col in row:
                print(col, end='')
            print()

    def move_piece(self, direction):
        if direction == 'left':
            self.current_col -= 1
        elif direction == 'right':
            self.current_col += 1
        elif direction == 'down':
            self.current_row += 1
        elif direction == 'up':
            self.current_row -= 1

        if self.current_col < 0 or self.current_col >= 7:
            self.current_col = 7
        if self.current_row < 0 or self.current_row >= 10:
