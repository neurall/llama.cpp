#!/bin/bash
# The Strata engine (github.com/Niko1221/Strata, 0.2.15, engine 0.1.60) behind run.py's llama-server contract, for the 3-way gainers2 cells
# (user 2026-11-18: stock, Strata and ours side by side). run.py starts BUILD/llama-server -m MODEL --port PORT [flags]; this takes -m and --port,
# ignores the rest, prints "listening on" once Strata serves, copies Strata's engine log to stdout (run.py's server log), and stops Strata on SIGTERM.
# Strata is installed in /p/bw/sh (env.sh: its XDG folders), its model packs in /p/bw/sh/models. The arm is the build folder's name:
#   strata-0.2.15        Strata's own defaults: drafting as it picks (DFlash2 for UD-IQ4_XS, none for IQ3_S), int8 KV, expert tail skip on
#   strata-0.2.15-plain  no drafting (MTP, DFlash2 and prompt lookup off), f16 KV; the tail skip stays at Strata's default
#   strata-0.2.15-full   plain, and every routed expert is computed (STRATA_ROUTE_TAIL_SKIP=0, what stock and ours do)
#   strata-0.2.15-nsys   the settings of the model's last launch (run -full first), the engine under nsys: a per-kernel trace of 5 s of decode, no result row
# Every arm: one request at a time (--parallel 1, as every cell), 32k context (the longest cell prompt is 17.7k), no picture reader, no tuning run.
. /p/bw/sh/env.sh
case "$1" in
    --version) echo "version: 1 ($("$S" --version | cut -d"(" -f1 | xargs), engine $(ls -t /p/bw/sh/data/strata/components/engine | head -1 | cut -d- -f1))"; exit 0 ;;
    --help|-h) echo "usage: llama-server -m MODEL --port PORT (Strata stand-in, other flags are ignored)"; exit 0 ;;
esac
model= port=8080
while [ $# -gt 0 ]; do
    case "$1" in -m|--model) model=$2; shift ;; --port) port=$2; shift ;; esac
    shift
done
[ -n "$model" ] || { echo "strata stand-in: no -m MODEL" >&2; exit 2; }
arm=$(basename "$(dirname "$0")")
IFS=, read -ra vis <<< "${CUDA_VISIBLE_DEVICES:-0,1}"; gpus=$(seq -s, 0 $((${#vis[@]} - 1)))   # CUDA_VISIBLE_DEVICES=0 = one card (the engine counts the visible cards from 0)
args=(--yes --no-tui --model-path "$model" --gpu "$gpus" --context 32k --parallel 1 --vision off --tune skip --access local --port "$port" --no-api-key --data-dir /p/bw/sh/models)
case "$arm" in
    *-plain) args+=(--kv fp16 --drafting off --mtp off) ;;
    *-full)  args+=(--kv fp16 --drafting off --mtp off --set STRATA_ROUTE_TAIL_SKIP=0); export STRATA_ROUTE_TAIL_SKIP=0 ;;
esac
# prompt lookup off; the Inkling engine (strata-inkling) has no such option and stops at start on it
[[ $arm == *-plain || $arm == *-full ]] && [[ $(basename "$model") != Inkling* ]] && args+=(--set suffix-draft=0)
"$S" launch --stop >/dev/null 2>&1   # a server a killed run left behind
if [[ $arm == *-nsys ]]; then
    # the engine under nsys (engine-nsys.sh beside this file): Strata's own server, started directly on the settings of the model's last launch with the engine
    # replaced by the wrapper. Not through `strata launch`: it checks every engine file against its manifest and puts a changed engine aside.
    last=$(grep -l -F "$model" "$XDG_STATE_HOME"/strata/launch/*-32k.json 2>/dev/null | head -1)
    [ -n "$last" ] || { echo "strata stand-in: no earlier launch of $model (run the -full arm once: its settings are used)" >&2; exit 2; }
    export STRATA_NSYS_EXE=$(grep -o '"exe": *"[^"]*"' "$last" | head -1 | sed 's/.*"\([^"]*\)"$/\1/')
    T=$(dirname "$(dirname "$(readlink -f "$S")")")
    c=$(grep -o '"cwd": *"[^"]*"' "$last" | head -1 | sed 's/.*"\([^"]*\)"$/\1/'); [ -f "$c/serve/server.py" ] && T=$c   # the launch's control component (Inkling: 0.1.66, the terminal's server cannot read its tokenizer)
    here=$(dirname "$(readlink -f "$0")"); cfg=$(mktemp); ready=$(mktemp -u)
    "$T/python/bin/python3.12" -c 'import json, sys; d = json.load(open(sys.argv[1])); d.update(exe=sys.argv[3], port=int(sys.argv[4]), log=sys.argv[2] + ".engine.log"); json.dump(d, open(sys.argv[2], "w"))' "$last" "$cfg" "$here/engine-nsys.sh" "$port"
    echo "strata stand-in ($arm): server.py on the settings of $last, the engine under nsys"
    "$T/python/bin/python3.12" "$T/serve/server.py" --engine strata --config "$cfg" --port "$port" --no-api-key --gpu "$gpus" --ready-file "$ready" &
    srv=$!
    tail -n +1 -F "$cfg.engine.log" 2>/dev/null & tailpid=$!
    trap 'kill $srv $tailpid 2>/dev/null; wait $srv; exit 0' TERM INT
    until [ -s "$ready" ]; do kill -0 $srv 2>/dev/null || { echo "strata stand-in: the server ended before it was ready"; kill $tailpid 2>/dev/null; exit 1; }; sleep 1 & wait $!; done
    echo "main: server is listening on http://127.0.0.1:$port (strata $arm)"
    wait $srv; kill $tailpid 2>/dev/null; exit 1
fi
tailpid=
stop() { "$S" launch --stop; [ -n "$tailpid" ] && kill "$tailpid" 2>/dev/null; exit 0; }
trap stop TERM INT
echo "strata stand-in ($arm): $S launch ${args[*]}"
"$S" launch "${args[@]}" || exit 1
log=$(ls -t "$XDG_STATE_HOME"/strata/launch/*.engine.log 2>/dev/null | head -1)
[ -n "$log" ] && { tail -n +1 -F "$log" & tailpid=$!; }
echo "main: server is listening on http://127.0.0.1:$port (strata $arm)"
while curl -sf -m 10 "http://127.0.0.1:$port/health" >/dev/null; do sleep 5 & wait $!; done   # the TERM trap runs between sleeps
echo "strata stand-in: the server stopped answering /health"
"$S" launch --stop; [ -n "$tailpid" ] && kill "$tailpid" 2>/dev/null
exit 1
