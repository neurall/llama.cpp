# Vulkan backend module for the Linux release (docker build -t llama-rel-el8-vk -f fork/docker/Dockerfile.vulkan fork/docker): the release builder plus the
# LunarG SDK tarball (glslc, headers, loader; EL8's packages have no glslc), same version as the Windows build host. Built with -DGGML_BACKEND_DL=ON so
# libggml-vulkan.so is one more loadable backend next to CUDA in the same tarball; users' drivers bring libvulkan.so.1.
FROM llama-rel-el8
ARG VULKAN_SDK_VERSION=1.4.363.0
RUN cd /opt && wget -q https://sdk.lunarg.com/sdk/download/${VULKAN_SDK_VERSION}/linux/vulkansdk-linux-x86_64-${VULKAN_SDK_VERSION}.tar.xz \
 && tar xf vulkansdk-linux-x86_64-${VULKAN_SDK_VERSION}.tar.xz && rm vulkansdk-linux-x86_64-${VULKAN_SDK_VERSION}.tar.xz && ln -s /opt/${VULKAN_SDK_VERSION}/x86_64 /opt/vulkan
ENV VULKAN_SDK=/opt/vulkan PATH=/opt/vulkan/bin:$PATH LD_LIBRARY_PATH=/opt/vulkan/lib:$LD_LIBRARY_PATH CMAKE_PREFIX_PATH=/opt/vulkan
